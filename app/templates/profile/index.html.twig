{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!{% endblock %}

{% block body %}
    <details class="container shadow p-3">
        <summary class="bg-white text-center">Informations personnelles</summary>

        <div class="d-flex flex-column align-items-center mt-3">

            <div class="text-start" style="min-width: 300px;">
                <p><strong>Nom et Prénom :</strong> {{ user.lastName }} {{ user.firstName }}</p>
                <p><strong>Email :</strong> {{ user.email }}</p>
                {% for adresse in app.user.adresses %}
                    <p><strong>Adresse :</strong> {{ adresse.adressNumber }} {{ adresse.street }} {{ adresse.city }} {{ adresse.postal }}</p>
                {% endfor %}
            </div>

        </div>
    </details>
    <details class="container text-center shadow p-3 ">

        <summary class="bg-white">Mes Reservations</summary>
        <div class="bg-warning">
        {% for reservation in app.user.reservations %}
            {% set vehicule = reservation.vehicule %}

        <div class=" d-flex border-border shadow mb-3 bg-white">
            <div class="m-1">
              <img src="{{ asset('uploads/vehicules/' ~ vehicule.images) }}"
                 alt="{{ vehicule.nom }}">
            </div>
            <div class="mt-3 ">
                <h1>{{vehicule.nom }}</h1>
                <p ><strong>Date de debut:</strong> {{ reservation.dateDebut|date('d/m/Y H:i') }} </p>
                <p><strong>Date de fin:</strong> {{ reservation.dateFin|date('d/m/Y H:i') }} </p>
                <p><strong>Prix total:</strong> {{ reservation.total }} fcfa</p>
            </div>
        </div>




        {% endfor %}
        </div>


    </details>
    <details class="container text-center shadow p-3 ">
        <summary> Nous contacter</summary>

        {{ form_start(form, { attr: { class: 'form-control bg-warning' } }) }}
        <div>
            {{ form_row(form.name, { attr: { class: 'form-control' } })}}
        </div>
        <div>
            {{ form_row(form.email, { attr: { class: 'form-control' } }) }}
        </div>
        <div>
            {{ form_row(form.subject, { attr: { class: 'form-control' } }) }}
        </div>
            <div>
            {{ form_row(form.message, { attr: { class: 'form-control' } }) }}

        </div>
        <div>
            {{ form_widget(form.agreeTerms, { attr: { class: 'form-check-input' } }) }}
            {{ form_label(form.agreeTerms) }}
        </div>
        <button type="submit" class="btn btn-primary mt-3 mb-3">Envoyer</button>



        {{ form_end(form) }}



    </details>


{% endblock %}
